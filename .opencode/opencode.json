{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "shadow-architect",
  "subagent_depth": 2,
  "share": "disabled",

  "instructions": [
    "AGENTS.md",
    ".opencode/CLAUDE.md",
    "rules/**/*.rule.md"
  ],

  "skills": {
    "paths": [".opencode/skills"]
  },

  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".claude/**": "deny"
    },
    "edit": "ask",
    "bash": {
      "make *": "allow",
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git remote *": "allow",
      "git stash *": "allow",
      "git restore *": "allow",
      "git rm *": "allow",
      "zsh -n *": "allow",
      "bash scripts/validate-configs.sh": "allow",
      "tmux source-file -v *": "allow",
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "cat *": "allow",
      "wc *": "allow",
      "tree *": "allow",
      "git push *": "ask",
      "git pull *": "ask",
      "git checkout *": "ask",
      "git branch *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "rm *": "ask",
      "mv *": "ask",
      "cp *": "ask",
      "mkdir *": "ask",
      "sudo *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "rm -rf *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git reset --hard *": "deny",
      "git clean *": "deny"
    },
    "external_directory": {
      "/tmp/**": "allow",
      "/var/folders/**": "allow"
    }
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  "watcher": {
    "ignore": [
      "sessions/**",
      "cache/**",
      "tasks/**",
      "plans/**",
      "backups/**",
      "shell-snapshots/**",
      "file-history/**",
      ".git/**",
      "node_modules/**",
      ".venv/**",
      "__pycache__/**",
      "*.pyc"
    ]
  },

  "tools": {
    "write": true,
    "bash": true,
    "lsp": true,
    "skill": true
  },

  "lsp": true,
  "formatter": true,
  "snapshot": true
}
